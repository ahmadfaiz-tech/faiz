{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Website Live Server",
            "type": "shell",
            "command": "live-server",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Open in Browser",
            "type": "shell",
            "command": "start http://127.0.0.1:8080",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Git Commit & Push to gh-pages",
            "type": "shell",
            "command": "node",
            "args": [
                "commit.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
